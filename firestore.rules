rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendu != true;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Users can only write their own profile; admins fields are protected
      allow create: if isOwner(userId)
        && !('isAdmin' in request.resource.data)
        && !('suspendu' in request.resource.data);

      allow update: if (isOwner(userId)
          // Prevent users from granting themselves admin or unsuspending themselves
          && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys())
          && !('suspendu' in request.resource.data.diff(resource.data).affectedKeys()))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ── Séances ──────────────────────────────────────────────────────────────
    match /seances/{seanceId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid
        // Cap dureeMinutes to prevent fraudulent scores
        && request.resource.data.dureeMinutes is int
        && request.resource.data.dureeMinutes >= 1
        && request.resource.data.dureeMinutes <= 600;
      allow update, delete: if isAdmin();
    }

    // ── Objectifs journaliers ─────────────────────────────────────────────────
    match /objectifs/{objectifId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuth()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Repas ────────────────────────────────────────────────────────────────
    match /repas/{repasId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ── Profils publics (classement) ─────────────────────────────────────────
    match /profilsPublics/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId) && notSuspended();
    }

    // ── Side Quests (définitions) — lecture seule pour les users ─────────────
    match /sideQuests/{questId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Side Quests utilisateur ───────────────────────────────────────────────
    match /sideQuestsUtilisateurs/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuth()
        && notSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Invitations ───────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if isAuth() &&
        (resource.data.envoyeurId == request.auth.uid ||
         resource.data.destinataireId == request.auth.uid);
      allow create: if isAuth() && notSuspended()
        && request.resource.data.envoyeurId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.destinataireId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Paliers (scoring) — lecture seule pour les users ─────────────────────
    match /paliers/{palierId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
